{
  "name": "end-point-blank-js",
  "version": "0.13.0",
  "description": "Node.js and Express SDK for EndPointBlank: authorize service-to-service API calls, report endpoint versions, and see which clients still call deprecated API versions.",
  "homepage": "https://endpointblank.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EndPointBlank/end_point_blank_js.git"
  },
  "bugs": {
    "url": "https://github.com/EndPointBlank/end_point_blank_js/issues"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./middleware": "./src/middleware/report-interaction.js",
    "./express": "./src/express/index.js",
    "./package.json": "./package.json",
    "./src/*": "./src/*.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "test": "jest --coverage"
  },
  "keywords": [
    "endpointblank",
    "api",
    "middleware",
    "authorization",
    "api-versioning",
    "api-deprecation",
    "deprecation",
    "sunset",
    "api-lifecycle",
    "machine-to-machine",
    "m2m-auth",
    "api-audit-log",
    "express",
    "nodejs"
  ],
  "author": "Robert A. Lasch <rlasch@gmail.com>",
  "license": "UNLICENSED",
  "devDependencies": {
    "jest": "^29.7.0",
    "express": "^4.18.2"
  },
  "peerDependencies": {
    "express": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup/no-network.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/\\.claude/"
    ]
  }
}
